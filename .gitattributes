* text=auto eol=lf
# Preserve published build-input bytes: frozen updaters hash these raw files.
dekuforge/runtime_layer.py text eol=crlf
dekuforge/stable_engine.py text eol=crlf
dekuforge/stable_engine_source.json text eol=crlf
dekuforge/shader_tools.lock.json text eol=crlf
engine_overrides/frame_timing_v111.txt text eol=crlf
tools/bootstrap_shader_tools.py text eol=crlf
tools/bootstrap_stable_toolchain.py text eol=crlf
tools/build_stable_translator.py text eol=crlf
*.cmd text eol=crlf
# Preserve the pinned engine source byte for byte on every platform.
engine/** -text -whitespace
engine/SOURCE.json text eol=lf whitespace
# Unified patches need their significant blank context lines preserved.
engine_overrides/**/*.patch -whitespace
