+        __atomic_store_n(&g_health_binding, 0, __ATOMIC_RELEASE);
+        __atomic_fetch_or(&g_fnprof, FNPROF_CHEATS, __ATOMIC_RELAXED);
+        return;
+    }
+    if (value && value < capacity) wr(a + 8, 4, capacity);   // never revive after death or add containers
