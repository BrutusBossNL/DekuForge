+static uint64_t basic_int(uint32_t hash, uint32_t expected) {
+    uint64_t a = basic_entry(hash, expected, 0xd0, 1259, 40, 28, 8);
+    return a && guest_ok(a, 8, 2) ? a : 0;
+}
